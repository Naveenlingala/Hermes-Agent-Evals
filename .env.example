# Copy to .env (cp .env.example .env). Everything is optional: the demo runs fully on the mock runner with no secrets.
# `npm run start:real` / `./start.sh real` can prompt for the keys below and save them here for you.

PORT=3000
# Where the SQLite file lives (relative to the repo root)
DATA_DIR=.data
# Optional: make the mock runner really wait this many ms per run (0.5x-1.5x jitter) to watch the live progress panel.
# MOCK_DELAY_MS=800

# LLM judge: "auto" uses Anthropic if ANTHROPIC_API_KEY is set, otherwise the labelled mock judge.
JUDGE_MODE=auto
JUDGE_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (the API then returns 400 asking for the anthropic-workspace-id header):
# ANTHROPIC_WORKSPACE_ID=

# Provider key(s) for real Hermes runs. Hermes reads provider keys from the process environment (name depends on provider).
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Real Hermes execution (configs with runner="hermes"). Path/name of the Hermes CLI.
HERMES_BIN=hermes
HERMES_TIMEOUT_MS=300000

# Diagnostics: request/event trace ring buffer size and log verbosity
# TRACE_BUFFER=500
# LOG_LEVEL=debug
