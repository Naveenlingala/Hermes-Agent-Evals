{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "jsx": "preserve", "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "types": ["vite/client"],
    "paths": { "@shared": ["../backend/src/domain/types.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
